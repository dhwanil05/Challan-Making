DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uvita_erp?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# Comma-separated list; in development localhost on any port is also allowed
FRONTEND_URL="http://localhost:3000,http://localhost:3001"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Set to true to block new self-service sign-ups (e.g. invite-only production)
PUBLIC_SIGNUP_DISABLED=false
